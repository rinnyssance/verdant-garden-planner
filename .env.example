# Copy to .env (never commit .env). All settings are optional.
# Where the SQLite database lives (created on first run).
VERDANT_DB_PATH=data/verdant.db
# Per-garden photo folder.
VERDANT_PHOTO_DIR=data/photos
# "open-meteo" (default, live forecasts, no key needed) or "offline" (no network; weather shows as unavailable).
VERDANT_WEATHER=open-meteo
# Override provider endpoints (e.g. a self-hosted Open-Meteo or a commercial plan URL).
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
VERDANT_LOG_LEVEL=INFO
